# Данные и тяжёлые артефакты — вне git.
# data/train.parquet (~172 МБ) превышает лимит GitHub в 100 МБ.
data/*.parquet
*.parquet

# Feature store: в git остаются только манифесты со схемой.
data/v2/*
!data/v2/MANIFEST.md
data/v3/*
!data/v3/MANIFEST.md
data/segmented_base/*
data/segmented_predictions/*
data/exp1000/

# Модели и чекпоинты (регенерируются обучением).
*.npy
*.npz
*.pt
*.pth
*.cbm

# Артефакты обучения.
reports/ckpt_*/
reports/ckpt_stack_*/
reports/ckpt_exp14_*/
reports/exp1000_results.jsonl

# Сабмиты (~6 МБ каждый) — регенерируются скриптами эксперимента.
submissions/*.csv
!submissions/.gitkeep
archive/*/submissions/*.csv

# Секреты и ключи сервера.
fhp
*.pem
*.key

# Python.
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ОС и редакторы.
.DS_Store
.idea/
.vscode/

# Локальный мусор.
catboost_info/
*.log
